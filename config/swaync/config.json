{
    "$schema": "/usr/share/swaync/configSchema.json",
    "positionX": "right",
    "positionY": "top",
    "layer": "overlay",
    "control-center-width": 420,
    "control-center-height": 650,
    "control-center-margin-top": 12,
    "control-center-margin-bottom": 12,
    "control-center-margin-right": 14,
    "control-center-margin-left": 12,
    "notification-icon-size": 56,
    "notification-body-image-height": 120,
    "notification-body-image-width": 220,
    "timeout": 5,
    "timeout-low": 3,
    "timeout-critical": 0,
    "notification-grouping": true,
    "group-by-app": true,
    "widgets": [
        "dnd",
        "mpris",
        "title",
        "dnd",
        "volume",
        "backlight",
        "notifications",
        "buttons"
    ],
    "widget-config": {
        "dnd": {
            "text": "Do Not Disturb",
            "label": "󰂛"
        },
        "mpris": {
            "image-size": 64,
            "image-radius": 12,
            "show-album": true,
            "show-artists": true
        },
        "volume": {
            "label": "󰕾",
            "show-percentage": true
        },
        "backlight": {
            "label": "󰃟",
            "show-percentage": true
        },
        "buttons": [
            {
                "label": "󰐥",
                "command": "systemctl poweroff"
            },
            {
                "label": "󰜉",
                "command": "systemctl reboot"
            },
            {
                "label": "󰍃",
                "command": "loginctl terminate-user $USER"
            }
        ]
    }
}
